{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "../../dist-electron",
    "skipLibCheck": true,
    "types": ["../../types"]
  },
  // Tests live next to the code they cover but must never reach dist-electron.
  "exclude": ["**/*.test.ts"]
}
